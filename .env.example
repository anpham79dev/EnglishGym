# --- Server only. KHÔNG đặt trong NUXT_PUBLIC_* ---
GEMINI_API_KEY=
# Tên model chốt sau Buổi 0 (Flash có audio + structured output)
GEMINI_MODEL=gemini-flash-latest
# Lượt gọi Gemini mỗi ngày (B4: giữ thấp, có tự duyệt và dán JSON thay thế)
GEMINI_DAILY_LIMIT=10

# Dev: file SQLite. Prod: libsql://<db>.turso.io
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# Chuỗi ngẫu nhiên >= 32 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
