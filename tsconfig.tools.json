{
    "compilerOptions": {
        "noEmit": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["node"],
        "paths": { "#shared/*": ["./shared/*"] }
    },
    "include": ["drizzle.config.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
